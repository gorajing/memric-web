---
import AnnotatedRecord from './AnnotatedRecord.astro';
---
<section id="hero" aria-label="Hero">
  <!-- Lead block -->
  <div class="mx-auto max-w-[1180px] px-14">
    <div class="grid grid-cols-12 gap-5 pt-[62px]">
      <div class="col-span-4 font-mono text-[11px] tracking-[0.06em] uppercase text-accent pt-2">Institutional&nbsp;judgment&nbsp;memory</div>
      <h1 class="col-span-10 text-[48px] font-semibold tracking-[-0.035em] leading-[1.05]">Your firm has perfect records — and no memory of its own judgment.</h1>
    </div>
    <div class="grid grid-cols-12 gap-5 mt-[28px]">
      <p class="col-span-7 text-[16.5px] leading-[1.6] text-[#3a3a3a]">Memric reads your IC memos, post-mortems, and theses and surfaces what you believed, what got contradicted, who dissented correctly, and which live proposals echo a prior failed assumption.</p>
      <div class="col-span-5 flex items-start justify-end pt-1">
        <a href="mailto:jin@memric.ai" class="bg-ink text-paper px-[22px] py-[13px] text-[14px] font-medium no-underline">Get in touch</a>
      </div>
    </div>
  </div>

  <!-- Annotated record artifact -->
  <AnnotatedRecord />
</section>
