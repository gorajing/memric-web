---
const ledgerItems = [
  {
    key: 'prediction',
    type: 'Prediction',
    status: 'resolved',
    detail: 'Demand outruns supply through 2024-Q4',
    meta: '+0.8σ author calibration',
    source: 'SRC-2309-A17 / paragraph 1',
    tone: 'green',
  },
  {
    key: 'principle',
    type: 'Principle',
    status: 'retired',
    detail: 'AI-infrastructure margins are structurally durable',
    meta: 'superseded by 3 post-mortems',
    source: 'PRI-0042 / retired 2026-Q1',
    tone: 'red',
  },
  {
    key: 'dissent',
    type: 'Dissent',
    status: 'vindicated',
    detail: 'In-house silicon compresses the moat faster than expected',
    meta: 'J. Okafor was 14 months early',
    source: 'DST-2405-C12 / dissent thread',
    tone: 'green',
  },
  {
    key: 'echo',
    type: 'Echo',
    status: 'active',
    detail: 'Current proposal repeats the same margin assumption',
    meta: 'matched to PRI-0042',
    source: 'LIVE-2606-P01 / proposal match',
    tone: 'red',
  },
];

const metrics = [
  { value: '12', label: 'Meridian docs' },
  { value: '47', label: 'judgment records' },
  { value: '9', label: 'report sections' },
  { value: '0', label: 'unsourced claims' },
];

const tapeItems = [
  'source span captured',
  'prediction resolved',
  'dissent vindicated',
  'principle retired',
  'contradiction opened',
  'proposal matched',
];
---
<section id="ledger" aria-label="Decision ledger introduction" class="hero-field border-b border-ink/80">
  <div class="mx-auto max-w-[1320px] px-5 sm:px-8 lg:px-12">
    <div class="grid gap-8 pt-9 pb-7 sm:gap-10 sm:pt-12 sm:pb-8 lg:grid-cols-[1.05fr_0.95fr] lg:pt-16">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-4">
          <div class="h-px w-12 bg-accent"></div>
          <div class="font-mono text-[11px] tracking-[0.12em] uppercase text-accent">Institutional judgment memory</div>
        </div>
        <h1 class="hero-title font-display mt-4 text-[46px] font-semibold leading-[0.9] tracking-normal text-ink sm:text-[76px] lg:text-[96px]">
          Your firm remembers every document. <span class="hero-forget"><span class="hero-forget-text">It&nbsp;forgets every judgment.</span></span>
        </h1>
      </div>
      <div class="lg:col-start-2">
        <p class="max-w-[58ch] text-[18px] leading-[1.65] text-pretty text-bodytext">
          Memric turns IC memos, post-mortems, and meeting notes into a Decision Ledger: what the firm believed, who dissented, what held up — and which live decisions echo old mistakes.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 sm:mt-7">
          <a href="mailto:jin@memric.ai" class="bg-ink px-[22px] py-[13px] text-[14px] font-medium text-paper no-underline transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Get in touch</a>
          <a href="/meridian-report/" class="border border-accent px-[22px] py-[13px] text-[14px] font-medium text-accent no-underline transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">View sample report</a>
          <a href="https://github.com/gorajing/memric" class="border border-ink px-[22px] py-[13px] text-[14px] font-medium text-ink no-underline transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">View GitHub</a>
        </div>
        <div class="mt-6 grid grid-cols-2 gap-px border border-ink bg-ink sm:mt-7 sm:grid-cols-4">
          {metrics.map((metric) => (
            <div class="bg-paper px-4 py-3">
              <p class="font-display text-[32px] leading-none text-ink">{metric.value}</p>
              <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.08em] text-caption">{metric.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="audit-panel evidence-link-panel border-y-2 border-ink bg-paper" data-evidence-panel>
      <div class="grid gap-px bg-ink lg:grid-cols-[1fr_0.92fr]">
        <article class="bg-sectionpaper p-5 sm:p-7 lg:p-8" aria-labelledby="raw-memo-heading">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/15 pb-4">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-graytext">Raw source document</p>
              <h2 id="raw-memo-heading" class="font-display mt-1 text-[24px] font-semibold tracking-normal">IC memo / NVDA initiation / 2023-Q3</h2>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-caption">SRC-2309-A17</span>
          </div>
          <div class="mt-6 max-w-[68ch] space-y-4 text-[15px] leading-[1.72] text-bodytext">
            <p>
              The thesis rests on <mark data-evidence="prediction" class="evidence-source bg-redtint px-1 text-ink">data-center GPU demand outrunning supply through at least 2025</mark>, with the CUDA software moat insulating gross margins from commoditization.
            </p>
            <p>
              We hold that <mark data-evidence="principle echo" class="evidence-source bg-redtint px-1 text-ink">AI-infrastructure margins are structurally durable</mark> as hyperscaler capex compounds. The principal risk is <span data-evidence="dissent" class="evidence-source px-1">in-house silicon compressing the moat faster than the market expects</span>.
            </p>
            <p data-evidence="dissent" class="evidence-source border-l-2 border-correct bg-paper/60 py-2 pl-4 text-[14px] text-caption">
              Dissent recorded: J. Okafor argues hyperscaler ASIC programs will cap margin expansion by 2025.
            </p>
          </div>
        </article>

        <aside class="bg-ink p-5 text-paper sm:p-7 lg:p-8" aria-labelledby="ledger-heading">
          <div class="flex items-start justify-between gap-4 border-b border-white/20 pb-4">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-white/50">Memric Decision Ledger</p>
              <h2 id="ledger-heading" class="font-display mt-1 text-[25px] font-semibold tracking-normal">Typed memory extracted from the memo.</h2>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-white/50">4 records</span>
          </div>
          <div class="mt-5 flex items-center justify-between gap-4 border border-white/15 bg-white/[0.04] px-3 py-2 font-mono text-[10px] uppercase tracking-[0.08em] text-white/48">
            <span>Select a record</span>
            <span class="text-accent">source trace active</span>
          </div>
          <div class="mt-3 grid gap-3">
            {ledgerItems.map((item) => (
              <button type="button" data-ledger-trigger={item.key} class={`ledger-record audit-panel-lift border text-left ${item.tone === 'green' ? 'border-correct/70' : 'border-accent/80'} bg-paper px-4 py-3 text-ink`}>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-graytext">{item.type}</span>
                  <span class={`font-mono text-[10px] uppercase tracking-[0.08em] ${item.tone === 'green' ? 'text-correct' : 'text-accent'}`}>{item.status}</span>
                </div>
                <p class="mt-2 text-[14px] font-semibold leading-snug tracking-normal">{item.detail}</p>
                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] leading-relaxed text-caption">
                  <span>{item.meta}</span>
                  <span class="ledger-source uppercase tracking-[0.06em]">{item.source}</span>
                </div>
              </button>
            ))}
          </div>
        </aside>
      </div>

      <div class="ticker border-x border-b border-ink bg-paper py-3 font-mono text-[11px] uppercase tracking-[0.12em] text-caption" aria-label="Evidence process tape">
        <div class="ticker-track">
          {[...tapeItems, ...tapeItems].map((item) => (
            <span class="mx-5 inline-flex items-center gap-5"><span class="text-accent">+</span>{item}</span>
          ))}
        </div>
      </div>
      <div class="grid gap-px bg-hairline border-x border-b border-ink sm:grid-cols-4">
        {['Sector thesis', 'IC memo', 'Post-mortem', 'Retired principle'].map((step, index) => (
          <div class="bg-paper px-4 py-4">
            <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-gutter">0{index + 1}</p>
            <p class="mt-1 text-[13px] font-semibold text-ink">{step}</p>
          </div>
        ))}
      </div>
      <p class="px-1 py-3 font-mono text-[12px] text-graytext">Illustrative Meridian example. Memric runs on your firm's own documents.</p>
    </div>
  </div>
</section>

<script>
  const evidencePanels = document.querySelectorAll<HTMLElement>('[data-evidence-panel]');

  evidencePanels.forEach((panel) => {
    const triggers = Array.from(panel.querySelectorAll<HTMLElement>('[data-ledger-trigger]'));
    const sources = Array.from(panel.querySelectorAll<HTMLElement>('[data-evidence]'));

    const setActiveEvidence = (key: string | undefined) => {
      if (!key) return;

      triggers.forEach((trigger) => {
        const active = trigger.dataset.ledgerTrigger === key;
        trigger.classList.toggle('is-active', active);
        trigger.setAttribute('aria-pressed', String(active));
      });

      sources.forEach((source) => {
        const keys = source.dataset.evidence?.split(' ') ?? [];
        source.classList.toggle('is-active', keys.includes(key));
      });

      panel.setAttribute('data-active-evidence', key);
    };

    triggers.forEach((trigger) => {
      trigger.setAttribute('aria-pressed', 'false');
      trigger.addEventListener('mouseenter', () => setActiveEvidence(trigger.dataset.ledgerTrigger));
      trigger.addEventListener('focus', () => setActiveEvidence(trigger.dataset.ledgerTrigger));
      trigger.addEventListener('click', () => setActiveEvidence(trigger.dataset.ledgerTrigger));
    });

    // --- Extraction scene: a lineage edge draws from the memo's source span to the
    // principle record, which types itself into the ledger. Plays once, then hands
    // state to the live hover-trace above. Progressive enhancement only: SSR markup
    // is the settled state, so no-JS, reduced-motion, and skipped-past visitors see
    // the page exactly as it is today.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mark = panel.querySelector<HTMLElement>('mark[data-evidence~="principle"]');
    const record = triggers.find((t) => t.dataset.ledgerTrigger === 'principle');
    const sceneEligible =
      !reduceMotion && mark && record && panel.getBoundingClientRect().bottom > 0;

    const settle = () => setActiveEvidence(triggers[0]?.dataset.ledgerTrigger);

    if (!sceneEligible || !mark || !record) {
      settle();
      return;
    }

    const tagFields = () => {
      const headSpans = record.querySelectorAll<HTMLElement>(':scope > div:first-child > span');
      const detail = record.querySelector<HTMLElement>(':scope > p');
      const metaSpans = record.querySelectorAll<HTMLElement>(':scope > div:last-child > span');
      const fields: Array<{ el: HTMLElement; delay: number; dur: number }> = [];
      if (headSpans[0]) fields.push({ el: headSpans[0], delay: 0, dur: 160 });
      if (headSpans[1]) fields.push({ el: headSpans[1], delay: 140, dur: 160 });
      if (detail) fields.push({ el: detail, delay: 320, dur: 420 });
      if (metaSpans[0]) fields.push({ el: metaSpans[0], delay: 760, dur: 240 });
      if (metaSpans[1]) fields.push({ el: metaSpans[1], delay: 920, dur: 280 });
      return fields;
    };

    const drawEdge = (): SVGSVGElement | null => {
      if (!window.matchMedia('(min-width: 1024px)').matches) return null;
      const ns = 'http://www.w3.org/2000/svg';
      const pr = panel.getBoundingClientRect();
      const mr = mark.getBoundingClientRect();
      const rr = record.getBoundingClientRect();
      const ar = (record.closest('aside') ?? record).getBoundingClientRect();
      const x1 = mr.right - pr.left - 5;
      const yT = mr.top - pr.top;
      const yLane = yT - 10;
      const x2 = rr.left - pr.left - 2;
      const y2 = rr.top + rr.height / 2 - pr.top;
      const gx = ar.left - pr.left - 16;
      const r = 10;

      const svg = document.createElementNS(ns, 'svg') as SVGSVGElement;
      svg.setAttribute('class', 'extract-edge');
      svg.setAttribute('viewBox', `0 0 ${pr.width} ${pr.height}`);
      svg.setAttribute('width', String(pr.width));
      svg.setAttribute('height', String(pr.height));
      svg.setAttribute('aria-hidden', 'true');

      const path = document.createElementNS(ns, 'path');
      path.setAttribute(
        'd',
        `M ${x1} ${yT} L ${x1} ${yLane + r} Q ${x1} ${yLane}, ${x1 + r} ${yLane} ` +
          `L ${gx - r} ${yLane} Q ${gx} ${yLane}, ${gx} ${yLane + r} ` +
          `L ${gx} ${y2 - r} Q ${gx} ${y2}, ${gx + r} ${y2} L ${x2} ${y2}`
      );
      path.style.fill = 'none';
      path.style.stroke = 'var(--color-accent)';
      path.style.strokeWidth = '1.5';
      svg.appendChild(path);

      for (const [cx, cy] of [[x1, yT], [x2, y2]] as const) {
        const node = document.createElementNS(ns, 'rect');
        node.setAttribute('x', String(cx - 3));
        node.setAttribute('y', String(cy - 3));
        node.setAttribute('width', '6');
        node.setAttribute('height', '6');
        node.style.fill = 'var(--color-paper)';
        node.style.stroke = 'var(--color-accent)';
        svg.appendChild(node);
      }

      panel.appendChild(svg);
      const len = path.getTotalLength();
      path.style.strokeDasharray = String(len);
      path.style.strokeDashoffset = String(len);
      path.animate([{ strokeDashoffset: len }, { strokeDashoffset: 0 }], {
        duration: 450,
        easing: 'ease',
        fill: 'forwards',
      });
      return svg;
    };

    // Arm: the record waits as an untyped dashed shell until the panel is 55% visible.
    const fields = tagFields();
    panel.classList.add('extract-scene');
    fields.forEach((f) => f.el.classList.add('extract-f'));
    record.classList.add('extract-pending');

    const playScene = () => {
      setTimeout(() => {
        panel
          .querySelectorAll<HTMLElement>('[data-evidence~="principle"]')
          .forEach((el) => el.classList.add('is-active'));
      }, 60);

      let edge: SVGSVGElement | null = null;
      setTimeout(() => {
        edge = drawEdge();
      }, 220);

      setTimeout(() => {
        record.classList.remove('extract-pending');
        record.classList.add('extract-typing');
        fields.forEach((f) => {
          f.el.style.setProperty('--extract-delay', `${f.delay}ms`);
          f.el.style.setProperty('--extract-dur', `${f.dur}ms`);
          f.el.style.setProperty(
            '--extract-steps',
            String(Math.max(6, Math.min(40, (f.el.textContent ?? '').length)))
          );
        });
      }, 700);

      setTimeout(() => {
        if (edge) {
          edge.style.opacity = '0';
          setTimeout(() => edge?.remove(), 340);
        }
        record.classList.remove('extract-typing');
        fields.forEach((f) => {
          f.el.classList.remove('extract-f');
          f.el.style.removeProperty('--extract-delay');
          f.el.style.removeProperty('--extract-dur');
          f.el.style.removeProperty('--extract-steps');
        });
        panel.classList.remove('extract-scene');
        setActiveEvidence('principle');
      }, 2050);
    };

    // A tall panel (mobile) can never hit 0.55 visibility — scale the threshold
    // to "60% of the viewport is showing panel" when the panel exceeds the viewport.
    const ratioNeeded = Math.min(0.55, (window.innerHeight * 0.6) / Math.max(1, panel.offsetHeight));

    const skipScene = () => {
      record.classList.remove('extract-pending');
      fields.forEach((f) => f.el.classList.remove('extract-f'));
      panel.classList.remove('extract-scene');
      settle();
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.boundingClientRect.bottom < 0) {
            io.disconnect();
            skipScene();
            return;
          }
          if (entry.intersectionRatio >= ratioNeeded) {
            io.disconnect();
            playScene();
          }
        });
      },
      // 0 must be a threshold too: an instant jump from partial visibility to
      // offscreen never crosses ratioNeeded, but it does cross 0 — without it
      // the skip path never fires and the shell sticks.
      { threshold: [0, ratioNeeded] }
    );
    io.observe(panel);
  });
</script>
