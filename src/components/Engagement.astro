---
import ReportThumbnail from './viz/ReportThumbnail.astro';
const steps = [
  { n: '01', t: '12 demo documents', d: 'IC memos, post-mortems, sector theses, quarterly letters, meeting notes, and dissent threads.' },
  { n: '02', t: 'Typed judgment records', d: 'Principles, predictions, dissent, contradictions, retirements, and source-linked evidence spans.' },
  { n: '03', t: '9-section report', d: 'A Decision Memory Report built from the ledger, with every claim cited back to source.' },
];
---
<section id="audit" aria-labelledby="audit-heading" class="border-t border-ink/80 bg-ink text-paper">
  <div class="mx-auto max-w-[1320px] px-5 py-16 sm:px-8 sm:py-24 lg:px-12">
    <div class="grid gap-10 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
      <div class="lg:sticky lg:top-28" data-reveal>
        <p class="font-mono text-[11px] tracking-[0.12em] uppercase text-accent mb-4">Meridian proof run</p>
        <h2 id="audit-heading" class="font-display text-balance text-[42px] sm:text-[62px] font-semibold tracking-normal leading-[0.95] max-w-[13ch]">See the audit before the first call.</h2>
        <p class="text-[17px] leading-[1.7] text-pretty text-white/72 mt-5 max-w-[58ch]">Meridian Capital is fictional. Everything below is real output — the engine run end to end on its 12-document corpus.</p>
      </div>

      <div class="grid gap-5" data-reveal style="--reveal-delay: 140ms">
        <ol role="list" class="border border-white/20 bg-white/[0.04]">
        {steps.map((s) => (
          <li class="grid grid-cols-[40px_1fr] items-center gap-x-5 gap-y-1 px-5 py-5 border-b border-white/10 last:border-b-0 sm:grid-cols-[48px_180px_1fr]">
            <span class="inline-flex h-8 w-8 items-center justify-center border border-white/30 bg-ink font-mono text-[11px] text-white">{s.n}</span>
            <span class="text-[15px] font-semibold text-paper">{s.t}</span>
            <span class="col-start-2 text-[13.5px] text-white/62 leading-relaxed sm:col-start-auto">{s.d}</span>
          </li>
        ))}
        </ol>
        <div class="grid gap-px bg-white/20 border border-white/20 md:grid-cols-[0.62fr_1fr]">
          <div class="bg-paper p-5 text-ink sm:p-6">
            <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-graytext">Decision Memory Audit / 4 weeks</p>
            <h3 class="font-display mt-3 text-[30px] font-semibold tracking-normal leading-tight">You keep the report and the running Memric instance.</h3>
            <p class="mt-3 text-[14px] leading-relaxed text-pretty text-caption">The deliverable is not a slide summary. It is a defensible record of the firm's judgment history, with source lineage on every assertion.</p>
            <a href="/meridian-report/" class="mt-5 inline-flex border border-ink px-4 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-ink no-underline transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Open sample report</a>
          </div>
          <div class="bg-paper text-ink">
            <ReportThumbnail />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
