---
import ReportThumbnail from './viz/ReportThumbnail.astro';
const steps = [
  { n: '01', t: 'Intake', d: 'A representative slice of your decision corpus — memos, post-mortems, theses, letters.' },
  { n: '02', t: 'Compress', d: 'Memric extracts typed, lineage-traced principles, predictions, dissent, and contradictions.' },
  { n: '03', t: 'Report', d: 'A 9-section Decision Memory Report, every claim cited back to a source document.' },
];
---
<section id="approach" aria-labelledby="approach-heading" class="border-t border-hairline">
  <div class="mx-auto max-w-[1180px] px-14 py-20 grid lg:grid-cols-2 gap-12 items-start">
    <div>
      <div class="font-mono text-[11px] tracking-[0.06em] uppercase text-accent mb-4">The engagement</div>
      <h2 id="approach-heading" class="text-[34px] font-semibold tracking-[-0.03em] max-w-[16ch]">A four-week Decision Memory Audit.</h2>
      <p class="text-[16px] text-bodytext mt-3.5 max-w-[52ch]">A fixed-scope engagement that turns your decision history into a defensible record. You keep the report and a Memric instance — every finding traces to a source document.</p>
      <div class="mt-9 border-t border-hairline">
        {steps.map((s) => (
          <div class="grid grid-cols-[40px_120px_1fr] gap-5 items-baseline py-4 border-b border-hairline">
            <span class="font-mono text-[12px] text-gutter">{s.n}</span>
            <span class="text-[14.5px] font-semibold">{s.t}</span>
            <span class="text-[13.5px] text-caption leading-relaxed">{s.d}</span>
          </div>
        ))}
      </div>
    </div>
    <ReportThumbnail />
  </div>
</section>
