---
// ContradictionPair — two active principles that can't both be true
// Ported verbatim from capabilities-visuals-v2.html .contra block
---
<div class="flex flex-col items-center justify-center h-full px-[22px] py-[22px]">
  <!-- Principle chip 1 -->
  <div class="w-full border border-hairline bg-paper px-[14px] py-[11px]">
    <div class="font-mono text-[10px] text-graytext">PRI-0051 · active · 2024-Q4</div>
    <div class="text-[13px] font-medium mt-[3px]">"Concentrate into proven winners."</div>
  </div>

  <!-- Contradiction divider -->
  <div
    class="font-mono text-[11px] text-accent py-2 flex items-center gap-2 tracking-[0.08em]"
  >
    <span class="inline-block w-[30px] h-px bg-accent"></span>
    <span aria-hidden="true">⚡</span> active contradiction
    <span class="inline-block w-[30px] h-px bg-accent"></span>
  </div>

  <!-- Principle chip 2 -->
  <div class="w-full border border-hairline bg-paper px-[14px] py-[11px]">
    <div class="font-mono text-[10px] text-graytext">PRI-0067 · active · 2026-Q1</div>
    <div class="text-[13px] font-medium mt-[3px]">"Diversify against single-name risk."</div>
  </div>
</div>
