---
// FRESH PROTOTYPE layout — parallel design exploration, noindexed.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '@fontsource/newsreader/latin-500-italic.css';
import '@fontsource/newsreader/latin-600-italic.css';
import '@fontsource/newsreader/latin-500.css';
import '../styles/fresh.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Memric — fresh design prototype</title>
    <meta name="description" content="Design exploration. Not the live site." />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-inkwarm focus:text-bone focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <slot />
    <script>
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-freveal], [data-fstamp]'));
      if (
        items.length > 0 &&
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('has-reveal');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.2 }
        );
        items.forEach((item) => io.observe(item));
      }
    </script>
  </body>
</html>
